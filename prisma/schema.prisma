generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RegistrationStatus {
  UNSUBMITTED 
  PENDING
  QUERIED
  APPROVED
  FAILED      // Added FAILED status for global tracking
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum OfficerRole {
  DIRECTOR
  SECRETARY
  SHAREHOLDER
  PSC
}

enum TwoFactorMethod {
  EMAIL
  AUTHENTICATOR
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id              String           @id @default(cuid())
  role            Role             @default(USER)
  firstName       String
  middleName      String?
  lastName        String
  email           String           @unique
  phone           String           @unique
  whatsapp        String           @unique
  oldPhone        String?          // Tracks previous number in case of fraud
  phoneChangedAt  DateTime?        // Tracks when they last changed it
  image          String?           // Added for profile picture
  passwordHash    String
  gender          Gender
  state           String
  lga             String
  street          String
  buildingNo      String?
  ipAddress       String?          // Tracks registration IP

  referralCode       String?   @unique
  referredBy         String?   
  referralBalance    Decimal   @default(0.00) // Separate wallet
  totalSpent         Decimal   @default(0.00) // Tracks cumulative spend for triggers
  
  payoutBankCode     String?
  payoutBankName     String?
  payoutAccountNo    String?
  payoutAccountName  String?

  referralsGiven     Referral[] @relation("Referrer")
  withdrawals        ReferralWithdrawal[]
  
  // Two-Factor Authentication (MFA) Fields
  twoFactorEnabled Boolean         @default(false)
  twoFactorMethod  TwoFactorMethod?
  twoFactorSecret  String?         // Stores encrypted Base32 TOTP secret for Google Authenticator
  
  // Marketing & Email Broadcast Subscriptions
  isSubscribedToMarketing Boolean  @default(true)
  
  isSuspended   Boolean   @default(false) // Allows MD to lock out malicious users
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  registrations    BusinessRegistration[]
  llcRegistrations LlcRegistration[]
  ninRequests      NinRequestLog[]
  ninIpeRequests   NinIpeRequest[]
  ninValidationRequests NinValidationRequest[]
  ninPersonalizationRequests NinPersonalizationRequest[]
  scumlRequests    ScumlRegistration[]
  taxIdRequests    TaxIdRequest[]
  notifications    InAppNotification[]
  wallet           Wallet?
  waitlists        Waitlist[]
  twoFactorCodes   TwoFactorCode[]
  staffActions     StaffActionLog[]
  promoUsages      PromoUsage[]
  
  // --- EMAIL CAMPAIGNS ---
  campaignsCreated EmailCampaign[]    @relation("CampaignAuthor")
  campaignLogs     EmailCampaignLog[]
  
  // --- USER ACTIVITY & AUTOMATED EMAIL LOGS ---
  activityLogs       UserActivityLog[]
  automatedEmailLogs AutomatedEmailLog[]
  
  // --- STAFF ASSIGNMENTS ---
  assignedBiz      BusinessRegistration[] @relation("BizStaffAssignment")
  assignedLlcs     LlcRegistration[]      @relation("LlcStaffAssignment")
}

// ==========================================
// BUSINESS NAME REGISTRATION
// ==========================================

model BusinessRegistration {
  id                String             @id @default(cuid())
  trackingId        String?            @unique // Short numeric ID (e.g., "482910")
  userId            String
  proposedName      String
  altName1          String?
  altName2          String?
  ownershipType     String?
  entityType        String             
  category          String             
  businessType      String?
  specificNature    String             
  status            RegistrationStatus @default(UNSUBMITTED) 
  similarityScore   String?
  queryReason       String?            @db.Text
  queryStatus       String?            @default("UNRESOLVED")
  queryDate         DateTime?
  registrationNumber String?           // BN Number
  taxId              String?           // TIN
  certificateUrl     String?           // PDF URL
  statusReportUrl    String?           // PDF URL
  
  // --- COMPANY INFORMATION ---
  companyEmail      String?
  companyState      String?
  companyCity       String?
  companyStreetNo   String?
  companyAddress    String?
  commencementDate  String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  processedAt       DateTime?          // Used for Staff TAT (Turnaround Time) tracking
  
  // --- STAFF ASSIGNMENT ---
  assignedToId      String?
  assignedStaff     User?              @relation("BizStaffAssignment", fields: [assignedToId], references: [id])

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  proprietors       Proprietor[]      
}

model Proprietor {
  id             String               @id @default(cuid())
  registrationId String
  surname        String
  firstName      String
  otherName      String?
  email          String?
  phoneCode      String               @default("+234") 
  phone          String
  gender         Gender
  dob            String
  state          String
  lga            String
  city           String
  streetNo       String?
  serviceAddress String

  // Embedded Document Cloudinary URLs
  ninUrl         String?
  passportUrl    String?
  signatureUrl   String?
  
  registration   BusinessRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// ==========================================
// LLC / COMPANY REGISTRATION
// ==========================================

model LlcRegistration {
  id                  String             @id @default(cuid())
  trackingId          String?            @unique // Short numeric ID (e.g., "839201")
  userId              String
  status              RegistrationStatus @default(UNSUBMITTED)
  currentStep         Int                @default(1)
  
  proposedName        String             
  altName1            String?            
  altName2            String?
  similarityScore     String?            
  email               String?
  principalActivity   String?
  specificActivity    String?
  description         String?            @db.Text
  
  registeredAddress   Json?      
  headOfficeAddress   Json?
  useDefaultArticles  Boolean            @default(true)
  customArticles      Json?
  witnessDetails      Json?              
  memorandumObjects   String[]           
  
  companyType         String?
  totalShareCapital   Float?
  shareClasses        Json?              

  declarantDetails    Json?
  queryReason         String?            @db.Text
  queryStatus         String?            @default("UNRESOLVED")
  registrationNumber  String?            // RC Number
  taxId               String?            // TIN
  certificateUrl      String?            // PDF URL
  statusReportUrl     String?            // PDF URL
  memorandumUrl       String?            // PDF URL (LLC Only)

  witnessSignatureUrl   String?
  declarantSignatureUrl String?
  reasonRestrictionUrl  String?
  otherDocumentsUrl     String?
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  processedAt         DateTime?          // Used for Staff TAT (Turnaround Time) tracking
  
  // --- STAFF ASSIGNMENT ---
  assignedToId        String?
  assignedStaff       User?              @relation("LlcStaffAssignment", fields: [assignedToId], references: [id])
  
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  officers            CompanyOfficer[]
}

model CompanyOfficer {
  id                 String          @id @default(cuid())
  registrationId     String
  
  roles              OfficerRole[] 
  
  surname            String
  firstName          String
  otherName          String?
  dob                String
  gender             String
  nationality        String
  formerName         String?
  formerNationality  String?
  occupation         String
  phone              String
  email              String
  
  idType             String?
  idNumber           String?
  taxResidency       String?
  tin                String?
  
  residentialAddress Json?
  serviceAddress     Json?
  
  sharesAllotted     Float?
  pscDetails         Json?     
  
  idDocumentUrl      String?
  signatureUrl       String?
  
  registration       LlcRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// ==========================================
// NIMC / NIN SLIP SERVICES
// ==========================================

model NinSlipPricing {
  id          String   @id @default(cuid())
  slipType    String   @unique // "nin_regular", "nin_standard", "nin_premium"
  displayName String   // "Regular Slip", "Standard Slip", "Premium Card Slip"
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model NinRequestLog {
  id            String   @id @default(cuid())
  userId        String
  ninMasked     String   // Storing masked NIN or Phone (e.g., "********123") for privacy & audit
  slipType      String
  amountCharged Decimal  @db.Decimal(10, 2)
  status        String   // "SUCCESS" | "FAILED"
  reference     String   @unique // Links to Wallet Transaction reference
  pdfUrl        String?  @db.Text
  
  // Extracted demographic details for 24-hour retention
  searchType    String?  @default("NIN") // "NIN" | "PHONE"
  fullName      String?
  firstName     String?
  lastName      String?
  middleName    String?
  gender        String?
  dob           String?
  phone         String?
  address       String?  @db.Text
  userData      Json?
  providerUsed  String?  @default("DATAVERIFY")

  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NinIpeStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model NinIpeRequest {
  id            String       @id @default(cuid())
  userId        String
  trackingId    String
  reference     String       @unique // Matches ledger transaction reference
  provider      String       @default("DATAVERIFY") // "DATAVERIFY" | "AGENTHUB" | "MANUAL"
  externalReqId String?      // requestId returned by AgentHub or transaction_id from DataVerify
  status        NinIpeStatus @default(PROCESSING)
  
  // Resolved details when completed
  resolvedNin   String?      // 11-digit NIN
  newTrackingId String?      // New tracking ID if updated
  fullName      String?
  dob           String?
  gender        String?
  photoUrl      String?
  
  apiMessage    String?
  failureReason String?
  adminNotes    String?      @db.Text
  amountCharged Decimal      @db.Decimal(10, 2)
  apiResponse   Json?
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([trackingId])
}

enum NinPersonalizationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model NinPersonalizationRequest {
  id            String                   @id @default(cuid())
  userId        String
  trackingId    String
  reference     String                   @unique // Matches ledger transaction reference
  provider      String                   @default("DATAVERIFY") // "DATAVERIFY" | "MANUAL"
  externalTxId  String?                  // transaction_id returned by DataVerify
  status        NinPersonalizationStatus @default(PROCESSING)
  
  // Resolved details when completed
  resolvedNin   String?                  // 11-digit NIN
  fullName      String?
  dob           String?
  gender        String?
  phone         String?
  residenceState String?
  photoUrl      String?                  @db.Text
  pdfUrl        String?                  @db.Text // PDF slip base64 or URL
  userData      Json?                    // Complete personal details returned by DataVerify
  
  apiMessage    String?
  failureReason String?                  @db.Text
  adminNotes    String?                  @db.Text
  amountCharged Decimal                  @db.Decimal(10, 2)
  apiResponse   Json?
  
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  completedAt   DateTime?

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([trackingId])
  @@index([reference])
}

enum NinValidationCategory {
  NO_RECORD_FOUND
  VNIN_VALIDATION
  UPDATE_RECORD_MOD
}

enum NinValidationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model NinValidationRequest {
  id             String                @id @default(cuid())
  userId         String
  category       NinValidationCategory
  nin            String
  status         NinValidationStatus   @default(PROCESSING)
  amountCharged  Decimal               @db.Decimal(10, 2)
  transactionRef String                @unique
  failureReason  String?               @db.Text
  adminNotes     String?               @db.Text
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([nin])
  @@index([category])
}

// ==========================================
// SYSTEM AUTH, NOTIFICATIONS, LEDGER & WAITLIST
// ==========================================

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // "info" | "success" | "warning"
  link      String?  // Deep link (e.g., "/dashboard/cac/register/view/123")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String   @unique 
  code      String
  resendCount         Int       @default(0)
  nextResendAllowedAt DateTime?
  lockedUntil         DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Wallet {
  id          String        @id @default(cuid())
  userId      String        @unique
  balance     Decimal       @default(0.00) 
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model ServicePricing {
  id             String   @id @default(cuid())
  serviceKey     String   @unique 
  title          String   
  price          Decimal  @default(0.00)
  isActive       Boolean  @default(true) // MDS Kill Switch
  maintenanceMsg String?  // Custom banner text e.g., "CAC Portal is down"
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id            String            @id @default(cuid())
  walletId      String
  amount        Decimal
  balanceBefore Decimal            
  balanceAfter  Decimal            
  type          TransactionType    
  status        TransactionStatus  @default(PENDING) 
  reference     String             @unique 
  serviceCategory String?          @default("OTHER")
  description   String             
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  wallet        Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Waitlist {
  id        String   @id @default(cuid())
  userId    String
  service   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, service])
}

// ==========================================
// TWO-FACTOR AUTHENTICATION & SECURITY AUDIT TRAILS
// ==========================================

model TwoFactorCode {
  id        String   @id @default(cuid())
  userId    String
  code      String   // Hashed 6-digit verification code
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StaffActionLog {
  id          String   @id @default(cuid())
  userId      String   // ID of the Staff or MD performing the action
  action      String   // e.g., "QUERIED_CAC_APPLICATION", "APPROVED_LLC", "UPDATED_PRICING"
  targetId    String?  // ID of the affected registration, wallet, or user
  details     String?  // JSON string or summary of exact changes made
  ipAddress   String?  // Client IP address
  userAgent   String?  // Browser/Device string
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SecurityAuditLog {
  id          String   @id @default(cuid())
  email       String   // Attempted email address
  role        String?  // User role if account exists (ADMIN, STAFF, USER)
  event       String   // LOGIN_SUCCESS, LOGIN_FAILED, BRUTE_FORCE_LOCKOUT, UNAUTHORIZED_PORTAL_ACCESS
  ipAddress   String?  // Client IP address
  userAgent   String?  // Device / Browser string
  details     String?  // Failure reason or success metadata
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([event])
  @@index([createdAt])
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountPct   Float?
  fixedAmount   Decimal?     
  usageLimit    Int?         // Total available for ALL users globally
  restrictedServices String[] // e.g., ["LLC", "BUSINESS_NAME"] or ["ALL"]
  perUserLimit  Int          @default(1) // Max times a SINGLE user can use it
  timesUsed     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now()) // Added so chronological sorting works perfectly

  usages        PromoUsage[] // Tracks who used it
}

// NEW TABLE: The Redemption Ledger
model PromoUsage {
  id          String    @id @default(cuid())
  promoId     String
  userId      String
  usedAt      DateTime  @default(now())

  promo       PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoId])
  @@index([userId])
}

model BlockedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?  // e.g., "Spam registration"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalSetting {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "SUPPORT_WHATSAPP"
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ==========================================
// SCUML REGISTRATION
// ==========================================

enum ScumlType {
  BUSINESS_NAME
  LLC
  NGO
}

enum ScumlStatus {
  PENDING
  PROCESSING
  COMPLETED    
  FAILED       // NEW: Added FAILED status
}

model ScumlRegistration {
  id                String       @id @default(cuid())
  userId            String
  type              ScumlType
  companyName       String
 
  // User Uploaded Document URLs 
  certificateUrl    String
  statusReportUrl   String
  memorandumUrl     String?
  constitutionUrl   String?      

  // Admin Uploaded Final Certificate
  finalCertificateUrl String?    // Where the admin uploads the finished work

  status            ScumlStatus  @default(PENDING)
  failureReason     String?      @db.Text // NEW: Stores admin's reason for failure
  
  // Payment Tracking
  amountPaid        Decimal      @db.Decimal(10, 2)
  transactionRef    String       @unique

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// TAX ID (TIN) REGISTRATION
// ==========================================

enum TaxIdType {
  INDIVIDUAL
  CORPORATE
}

enum TaxIdStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED       // NEW: Added FAILED status
}

model TaxIdRequest {
  id                String       @id @default(cuid())
  userId            String
  type              TaxIdType
  status            TaxIdStatus  @default(PENDING)
  
  // Individual Fields
  nin               String?
  firstName         String?
  lastName          String?
  dob               String?

  // Corporate Fields
  cacNumber         String?
  corporateCategory String?

  // Output (Admin will upload the generated TIN here)
  taxIdNumber       String?
  taxIdImageUrl     String?      // ADD THIS LINE
  failureReason     String?      @db.Text // NEW: Stores admin's reason for failure
  
  // Payment Tracking
  amountPaid        Decimal      @db.Decimal(10, 2)
  transactionRef    String       @unique

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// REFERRAL SYSTEM & LEDGER
// ==========================================

model Referral {
  id               String   @id @default(cuid())
  referrerId       String   
  referredUserId   String   @unique // A user can only be referred once
  
  // Expiration for the 12-month earning window 
  expiresAt        DateTime? 

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  referrer         User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  commissions      ReferralCommission[]
}

// THE NEW LEDGER: Tracks every single payout to prevent fraud
model ReferralCommission {
  id             String   @id @default(cuid())
  referralId     String
  
  serviceType    String   // e.g., "CAC_BIZ", "CAC_LLC", "SCUML", "TAX_ID", "NIN"
  serviceId      String   @unique // The ID of the specific job. @unique prevents double-paying for the same job!
  
  amount         Decimal  @db.Decimal(10, 2) // The fixed admin-set price paid out at the time of completion
  createdAt      DateTime @default(now())

  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([serviceType])
}

model ReferralWithdrawal {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING") // PENDING | PAID | REJECTED
  bankName    String
  accountNo   String
  accountName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// EMAIL CAMPAIGNS & BROADCASTS
// ==========================================

model EmailCampaign {
  id              String           @id @default(cuid())
  title           String           // Internal reference name (e.g., "Easter Promo Blast")
  subject         String           // Public email subject line
  previewText     String?          // Email preheader text
  content         String           @db.Text // HTML or rich formatted email body
  senderName      String           @default("LoraBiz")
  targetAudience  Json?            // Filter criteria payload e.g. { segment: "ALL" | "REGISTERED" | "NO_ORDERS" }
  status          CampaignStatus   @default(DRAFT)
  totalRecipients Int              @default(0)
  sentCount       Int              @default(0)
  failedCount     Int              @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy       User             @relation("CampaignAuthor", fields: [createdById], references: [id])
  logs            EmailCampaignLog[]

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model EmailCampaignLog {
  id            String                 @id @default(cuid())
  campaignId    String
  userId        String?
  email         String
  recipientName String?
  status        CampaignDeliveryStatus @default(PENDING)
  errorMessage  String?                @db.Text
  sentAt        DateTime?
  createdAt     DateTime               @default(now())

  campaign      EmailCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([email])
}

// ==========================================
// USER ACTIVITY & EVENT LOG
// ==========================================

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // e.g. "USER_REGISTERED", "CAC_DRAFT_STARTED", "WALLET_FUNDING_SUCCESS"
  category    String   // "AUTH" | "CAC" | "WALLET" | "SERVICES" | "SECURITY"
  description String   // Clear, human-readable summary
  status      String   @default("SUCCESS") // "SUCCESS" | "PENDING" | "FAILED"
  referenceId String?  // e.g. CAC trackingId "849201", Tx Ref "FW_USR_..."
  metadata    Json?    // Safe metadata only (strictly zero secrets/passwords)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// AUTOMATED EMAIL LOG (DEDUP & AUDIT)
// ==========================================

model AutomatedEmailLog {
  id           String    @id @default(cuid())
  userId       String
  email        String
  emailType    String    // "WELCOME", "FIRST_WALLET_FUNDING", "ABANDONED_CAC"
  entityId     String?   // e.g. Registration ID or Transaction Reference
  status       String    @default("SENT") // "SENT" | "FAILED"
  errorMessage String?   @db.Text
  sentAt       DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emailType, entityId])
  @@index([userId])
  @@index([emailType])
  @@index([sentAt])
}


